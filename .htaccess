DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /AMCWebAPP/

    # Allow direct access to actual static files
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Pass everything else to index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
